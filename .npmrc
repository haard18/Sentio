# framer-motion-3d pins @react-three/fiber to exactly 8.2.2, which can never
# satisfy the ^8.17.6 this project needs. The pin is an upstream bug and the
# package is only reached from Orbitals.tsx, which nothing imports.
#
# Without this, `npm ci` fails with ERESOLVE and the Coolify build dies before
# it reaches the build step. Keep this file until framer-motion-3d is dropped.
legacy-peer-deps=true
